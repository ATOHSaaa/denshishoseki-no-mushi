---
import { site } from '@/config/site';
import { canonicalUrl } from '@/lib/seo';

interface Props {
  title: string;
  pathname: string;
}

const { title, pathname } = Astro.props;
const pageUrl = canonicalUrl(pathname);
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(`${title} | ${site.name}`);
---

<nav class="share-buttons" aria-label="記事をシェア">
  <a
    href={`https://b.hatena.ne.jp/add?mode=confirm&url=${encodedUrl}&title=${encodedTitle}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-buttons__item share-buttons__item--hatena"
    aria-label="はてなブックマークに追加"
  >
    <span class="share-buttons__label" aria-hidden="true">B!</span>
    <span class="sr-only">はてなブックマークに追加</span>
  </a>
  <a
    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-buttons__item share-buttons__item--twitter"
    aria-label="Xでシェア"
  >
    <span class="share-buttons__label share-buttons__label--x" aria-hidden="true">X</span>
    <span class="sr-only">Xでシェア</span>
  </a>
  <button
    type="button"
    class="share-buttons__item share-buttons__item--copy"
    data-url={pageUrl}
    aria-label="リンクをコピー"
  >
    <svg class="share-buttons__icon share-buttons__icon--link" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
      ></path>
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
      ></path>
    </svg>
    <svg class="share-buttons__icon share-buttons__icon--check" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M20 6 9 17l-5-5"
      ></path>
    </svg>
    <span class="sr-only">リンクをコピー</span>
  </button>
</nav>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-buttons__item--copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url;
      if (!url) return;

      const showCopied = () => {
        btn.classList.add('is-copied');
        btn.setAttribute('aria-label', 'コピーしました');
        setTimeout(() => {
          btn.classList.remove('is-copied');
          btn.setAttribute('aria-label', 'リンクをコピー');
        }, 2000);
      };

      try {
        await navigator.clipboard.writeText(url);
        showCopied();
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = url;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        showCopied();
      }
    });
  });
</script>
